{
  "name": "meditrack-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:widget": "vitest run test/widget",
    "test:browser": "playwright test",
    "test:integration": "vitest run test/integration",
    "test:e2e:flutter": "playwright test -c playwright.flutter.config.js",
    "coverage": "vitest run --coverage",
    "verify": "npm run coverage && python ../tool/coverage_report.py --react && python -m unittest discover -s test/tools -p *_test.py && npm run build && npm run test:browser"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "27.4.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
